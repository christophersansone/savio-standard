# Copy to .env for local testing. Not required for `npm run dev` / `npm run build` —
# analytics simply won't load without it.

# Cloudflare Web Analytics beacon token (cookie-free, no client-side storage).
# Get one at: Cloudflare dashboard → Analytics & Logs → Web Analytics → Add a site
# → saviostandard.org → copy the token out of the snippet (not the whole snippet).
# In production, set this as a build environment variable on the Worker, not in a
# committed file.
PUBLIC_CF_BEACON_TOKEN=
