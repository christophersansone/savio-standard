---
import '@fontsource-variable/source-sans-3';
import '../styles/global.css';
import { REPO_URL } from '../lib/registry';

// Resolved, content-hashed URL for the body face used above the fold on every
// page — preloaded below so Safari starts fetching it immediately instead of
// only after CSS is parsed. Bitter and Source Serif 4 are self-hosted from
// /public/fonts and preloaded by path.
import sourceSansUiFontUrl from '@fontsource-variable/source-sans-3/files/source-sans-3-latin-wght-normal.woff2?url';

interface Props {
  title?: string;
  description?: string;
  /** OpenGraph type: 'website' for landing/index pages, 'article' for documents */
  type?: 'website' | 'article';
}

const {
  title = 'The Savio Standard',
  description = 'A parent-led movement to rebuild culture in Catholic grade schools.',
  type = 'website',
} = Astro.props;

const pageTitle = title === 'The Savio Standard' ? title : `${title} · The Savio Standard`;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site);
const ogImage = new URL('/og.png', Astro.site);

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Organization',
      name: 'The Savio Standard',
      url: Astro.site?.toString(),
      logo: new URL('/favicon.svg', Astro.site).toString(),
      description,
    },
    {
      '@type': 'WebSite',
      name: 'The Savio Standard',
      url: Astro.site?.toString(),
    },
  ],
};

const nav = [
  { href: '/for-parents', label: 'For Parents' },
  { href: '/for-schools', label: 'For Schools' },
  { href: '/library', label: 'Library' },
];

const footerColumns = [
  {
    heading: 'The movement',
    links: [
      { label: 'For parents', href: '/for-parents' },
      { label: 'For schools & parishes', href: '/for-schools' },
      { label: 'Read the case', href: '/the-case' },
      { label: 'The covenant', href: '/covenant' },
    ],
  },
  {
    heading: 'Library',
    links: [
      { label: 'All documents', href: '/library' },
      { label: 'Glossary', href: '/glossary' },
      { label: 'Roles & responsibilities', href: '/roles' },
      { label: 'Facilitator onboarding', href: '/facilitators' },
    ],
  },
  {
    heading: 'Governance',
    links: [
      { label: 'Stewardship commitment', href: '/commitment' },
      { label: 'Stewardship & operations', href: '/stewardship' },
      { label: 'Strategic plan', href: '/plan' },
      { label: 'Repository', href: REPO_URL },
    ],
  },
];

const isActive = (href: string) => path === href || path.startsWith(href + '/');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap.xml" />
    <meta property="og:site_name" content="The Savio Standard" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={type} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="The Savio Standard — Anchor your school in the Golden Rule." />
    <meta property="og:locale" content="en_US" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="theme-color" content="#f5f3ed" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preload" as="font" type="font/woff2" href={sourceSansUiFontUrl} crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bitter-latin-wght-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/source-serif-4-latin-700-normal.woff2" crossorigin />
  </head>
  <body class="min-h-screen flex flex-col bg-page">
    <!-- The brand motif: a flat 3px gold rule. No gradients anywhere. -->
    <div class="h-[3px] bg-accent"></div>

    <header
      class="border-b border-hairline sticky top-0 z-20 supports-[backdrop-filter]:bg-[rgba(252,251,248,0.92)] bg-raised backdrop-blur-[10px] backdrop-saturate-150"
    >
      <div class="mx-auto max-w-page px-5 sm:px-8 py-3 flex items-center gap-6 sm:gap-8 relative">
        <a href="/" class="flex items-center gap-2.5 shrink-0 no-underline" aria-label="The Savio Standard — home">
          <img src="/images/shield.svg" alt="" width="36" height="36" class="block size-9" aria-hidden="true" />
          <span
            class="font-logo font-bold text-strong text-[18px] sm:text-xl leading-none tracking-[-0.005em] whitespace-nowrap"
          >
            The Savio Standard
          </span>
        </a>

        <nav class="hidden md:flex ml-auto items-center gap-6 font-sans text-sm font-semibold">
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'no-underline pb-1.5 border-b-[3px] transition-colors duration-140',
                  isActive(item.href)
                    ? 'text-strong border-accent'
                    : 'text-muted border-transparent hover:text-body',
                ]}
              >
                {item.label}
              </a>
            ))
          }
        </nav>

        <a
          href="/the-case"
          class="hidden md:inline-flex ml-2 h-8 items-center rounded-sm border-2 border-accent bg-accent px-4 font-sans text-2xs font-semibold uppercase tracking-caps text-on-gold no-underline transition-colors duration-140 hover:bg-accent-hover hover:border-accent-hover active:translate-y-px"
        >
          Read the case
        </a>

        <button
          id="nav-toggle"
          type="button"
          class="md:hidden ml-auto -mr-1.5 p-1.5 text-strong hover:text-accent-press transition-colors"
          aria-expanded="false"
          aria-controls="mobile-menu"
          aria-label="Open menu"
        >
          <svg id="icon-hamburger" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6">
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
          </svg>
          <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" class="size-6 hidden">
            <line x1="5" y1="5" x2="19" y2="19"></line>
            <line x1="19" y1="5" x2="5" y2="19"></line>
          </svg>
        </button>

        <nav
          id="mobile-menu"
          class="md:hidden absolute right-5 top-full mt-2 w-60 origin-top-right rounded-md border border-hairline bg-card shadow-raised py-2 flex flex-col font-sans text-sm font-semibold opacity-0 -translate-y-2.5 pointer-events-none transition duration-[220ms] ease-[cubic-bezier(.2,.6,.2,1)] z-30"
        >
          {
            nav.map((item) => (
              <a
                href={item.href}
                class:list={[
                  'px-4 py-2.5 no-underline border-l-[3px] transition-colors',
                  isActive(item.href)
                    ? 'text-strong border-accent bg-gold-100'
                    : 'text-muted border-transparent hover:text-body hover:bg-raised',
                ]}
              >
                {item.label}
              </a>
            ))
          }
          <a
            href="/the-case"
            class="px-4 py-2.5 no-underline border-l-[3px] border-transparent text-muted hover:text-body hover:bg-raised transition-colors"
          >
            Read the case
          </a>
        </nav>
      </div>
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="bg-navy-deep text-navy-200">
      <div class="mx-auto max-w-page px-5 sm:px-8 pt-16 pb-10">
        <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-[1.4fr_1fr_1fr_1fr]">
          <div>
            <img src="/images/shield-gold.svg" alt="" width="40" height="40" class="block size-10 mb-4" aria-hidden="true" />
            <p class="font-display text-xl font-bold leading-tight text-gold-300 tracking-tight">
              The Savio<br />Standard
            </p>
            <p class="font-sans text-sm text-navy-200 mt-4 max-w-[32ch]">
              Anchor your school in the Golden Rule. A lay movement under the patronage of
              St.&nbsp;Dominic&nbsp;Savio and St.&nbsp;John&nbsp;Bosco.
            </p>
          </div>
          {
            footerColumns.map((col) => (
              <div>
                <p class="eyebrow text-gold-400">{col.heading}</p>
                <ul class="list-none p-0 mt-4 flex flex-col gap-2">
                  {col.links.map((link) => (
                    <li>
                      <a
                        href={link.href}
                        class="font-sans text-sm text-navy-200 no-underline hover:text-gold-300 transition-colors duration-140"
                      >
                        {link.label}
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>

        <div class="mt-12 pt-5 border-t border-navy-700 flex flex-col sm:flex-row sm:justify-between gap-3 font-sans text-2xs text-navy-400">
          <p>
            Working draft · © 2026 The Savio Standard · Content licensed{' '}
            <a
              href={`${REPO_URL}/blob/master/LICENSE.md`}
              class="text-navy-400 underline underline-offset-2 hover:text-gold-300 transition-colors">CC BY-NC-SA 4.0</a>
          </p>
          <p>
            Free for families, forever. Not legal, medical, or professional advice — see{' '}
            <a href="/stewardship" class="text-navy-400 underline underline-offset-2 hover:text-gold-300 transition-colors">
              Stewardship &amp; Operations</a>.
          </p>
        </div>
      </div>
    </footer>

    <script>
      const toggle = document.getElementById('nav-toggle');
      const menu = document.getElementById('mobile-menu');
      const iconHamburger = document.getElementById('icon-hamburger');
      const iconClose = document.getElementById('icon-close');

      if (toggle && menu && iconHamburger && iconClose) {
        const setOpen = (open: boolean) => {
          toggle.setAttribute('aria-expanded', String(open));
          toggle.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
          menu.classList.toggle('opacity-100', open);
          menu.classList.toggle('translate-y-0', open);
          menu.classList.toggle('pointer-events-auto', open);
          menu.classList.toggle('opacity-0', !open);
          menu.classList.toggle('-translate-y-2.5', !open);
          menu.classList.toggle('pointer-events-none', !open);
          iconHamburger.classList.toggle('hidden', open);
          iconClose.classList.toggle('hidden', !open);
        };

        toggle.addEventListener('click', () => {
          setOpen(toggle.getAttribute('aria-expanded') !== 'true');
        });

        document.addEventListener('click', (e) => {
          const target = e.target as Node;
          if (!menu.contains(target) && !toggle.contains(target)) setOpen(false);
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') setOpen(false);
        });

        menu.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));

        window.matchMedia('(min-width: 768px)').addEventListener('change', (e) => {
          if (e.matches) setOpen(false);
        });
      }
    </script>
  </body>
</html>
