---
// Standalone, chrome-free layout for printer-friendly / "send this link"
// document views. No header, no nav, no footer, no background color, no
// display serif — just the content, styled to print cleanly and to read
// well on its own outside the site's visual identity.

interface Props {
  title: string;
  description?: string;
  /** canonical (non-print) URL this content also lives at, for SEO + provenance */
  canonicalPath: string;
}

const { title, description, canonicalPath } = Astro.props;
const canonical = new URL(canonicalPath, Astro.site);
const pageTitle = `${title} · The Savio Standard`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <!-- This is a print/handout view of the canonical page; point crawlers there. -->
    <link rel="canonical" href={canonical} />
    <meta name="robots" content="noindex, follow" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <style>
      :root {
        color-scheme: light;
      }

      * {
        box-sizing: border-box;
      }

      html,
      body {
        background: #fff;
        color: #111;
      }

      body {
        margin: 0;
        font-family:
          ui-sans-serif,
          system-ui,
          -apple-system,
          'Segoe UI',
          Helvetica,
          Arial,
          sans-serif;
        line-height: 1.55;
        -webkit-font-smoothing: antialiased;
      }

      .print-toolbar {
        display: flex;
        justify-content: space-between;
        padding: 1rem 1.5rem 0;
        max-width: 42rem;
        margin: 0 auto;
      }

      .print-toolbar button,
      .print-toolbar a {
        font-family: inherit;
        font-size: 0.8rem;
        font-weight: 600;
        color: #555;
        background: none;
        border: none;
        padding: 0;
        cursor: pointer;
        text-decoration: underline;
        text-decoration-color: #ccc;
        text-underline-offset: 3px;
      }

      .print-toolbar button:hover,
      .print-toolbar a:hover {
        color: #111;
        text-decoration-color: #999;
      }

      main {
        max-width: 42rem;
        margin: 0 auto;
        padding: 0.5rem 1.5rem 4rem;
      }

      header.doc-header {
        margin-bottom: 2rem;
        padding-bottom: 1.25rem;
        border-bottom: 1px solid #ddd;
      }

      .eyebrow {
        font-size: 0.7rem;
        font-weight: 700;
        letter-spacing: 0.14em;
        text-transform: uppercase;
        color: #555;
        margin: 0 0 0.5rem;
      }

      h1.doc-title {
        font-size: 1.9rem;
        line-height: 1.2;
        font-weight: 700;
        margin: 0;
        color: #000;
      }

      .doc-description {
        font-size: 0.98rem;
        color: #444;
        margin: 0.6rem 0 0;
        max-width: 38rem;
      }

      /* Content typography — deliberately plain: black text, no gold, no
         background tints, generous spacing for reading and for print. */
      .doc-content {
        font-size: 1.02rem;
      }

      .doc-content :global(h2) {
        font-size: 1.35rem;
        font-weight: 700;
        margin: 2rem 0 0.75rem;
        color: #000;
      }

      .doc-content :global(h3) {
        font-size: 1.12rem;
        font-weight: 700;
        margin: 1.5rem 0 0.5rem;
        color: #000;
      }

      .doc-content :global(p) {
        margin: 0 0 1em;
      }

      .doc-content :global(ul),
      .doc-content :global(ol) {
        margin: 0 0 1em;
        padding-left: 1.4em;
      }

      .doc-content :global(li) {
        margin: 0.25em 0;
      }

      .doc-content :global(a) {
        color: #111;
        text-decoration: underline;
        text-decoration-color: #999;
      }

      .doc-content :global(blockquote) {
        margin: 1em 0;
        padding: 0.5em 1em;
        border-left: 3px solid #ccc;
        color: #333;
        font-style: italic;
      }

      .doc-content :global(hr) {
        border: none;
        border-top: 1px solid #ddd;
        margin: 2em 0;
      }

      .doc-content :global(table) {
        width: 100%;
        border-collapse: collapse;
        font-size: 0.92em;
        margin: 1em 0;
      }

      .doc-content :global(th),
      .doc-content :global(td) {
        border: 1px solid #ddd;
        padding: 0.5em 0.7em;
        text-align: left;
      }

      .doc-content :global(strong) {
        font-weight: 700;
        color: #000;
      }

      .doc-content :global(code) {
        font-family: ui-monospace, Menlo, Consolas, monospace;
        font-size: 0.9em;
        background: #f3f3f3;
        padding: 0.1em 0.35em;
        border-radius: 0.25em;
      }

      footer.doc-footer {
        margin-top: 3rem;
        padding-top: 1rem;
        border-top: 1px solid #ddd;
        font-size: 0.78rem;
        color: #666;
      }

      footer.doc-footer a {
        color: #444;
      }

      @media print {
        .print-toolbar {
          display: none;
        }

        main {
          max-width: none;
          padding: 0;
        }

        a {
          color: #111 !important;
        }

        h2,
        h3 {
          break-after: avoid;
        }

        table,
        blockquote {
          break-inside: avoid;
        }
      }
    </style>
  </head>
  <body>
    <div class="print-toolbar">
      <a href={canonicalPath}>Back to site</a>
      <button type="button" onclick="window.print()">Print</button>
    </div>

    <main>
      <header class="doc-header">
        <slot name="eyebrow" />
        <h1 class="doc-title">{title}</h1>
        {description && <p class="doc-description">{description}</p>}
      </header>

      <div class="doc-content">
        <slot />
      </div>

      <footer class="doc-footer">
        <p>The Savio Standard · <a href={canonical.toString()}>{canonical.toString()}</a></p>
      </footer>
    </main>
  </body>
</html>
