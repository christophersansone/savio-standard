---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found" description="This page doesn’t exist — but the library does.">
  <section class="mx-auto max-w-rail px-5 sm:px-8 py-28">
    <hr class="rule-gold mb-5" />
    <p class="eyebrow">404</p>
    <h1 class="font-display text-4xl sm:text-5xl font-bold leading-snug tracking-tight text-strong mt-4">
      Not every path leads somewhere.
    </h1>
    <p class="font-sans text-lg text-muted mt-5 max-w-[62ch]">
      This page doesn’t exist. The documents you’re probably looking for are all in the library —
      free, forever.
    </p>
    <div class="flex flex-wrap gap-3 mt-8">
      <a href="/library" class="btn btn-lg btn-gold">Go to the library</a>
      <a href="/" class="btn btn-lg btn-secondary">Home</a>
    </div>
  </section>
</Base>
