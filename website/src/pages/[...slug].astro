---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import { docs, REPO_URL } from '../lib/registry';

export function getStaticPaths() {
  return docs.map((d) => ({ params: { slug: d.slug }, props: { doc: d } }));
}

const { doc } = Astro.props;
const entry = await getEntry(doc.collection, doc.id);
if (!entry) throw new Error(`Missing entry: ${doc.collection}/${doc.id}`);
const { Content } = await render(entry);
---

<Base title={doc.title} description={doc.description} type="article">
  <article class="mx-auto max-w-page px-5 py-16">
    <header class="pb-10">
      <hr class="rule-gold mb-5" />
      <p class="eyebrow">{doc.section}</p>
      <h1 class="font-display text-4xl sm:text-5xl font-bold leading-snug tracking-tight text-strong mt-4 text-balance">
        {doc.title}
      </h1>
      <p class="font-sans text-lg leading-relaxed text-muted mt-5 max-w-[62ch]">{doc.description}</p>
      <p class="mt-6 font-sans text-2xs uppercase tracking-caps text-subtle">
        <a
          href={`/print/${doc.slug}`}
          class="text-gold-600 no-underline hover:text-strong transition-colors duration-140"
        >
          printer-friendly version
        </a>
        {' · '}
        <a
          href={`${REPO_URL}/blob/master/${doc.srcPath}`}
          class="text-gold-600 no-underline hover:text-strong transition-colors duration-140"
        >
          suggest an edit
        </a>
      </p>
    </header>

    <div class="prose prose-savio prose-lg max-w-none">
      <Content />
    </div>
  </article>
</Base>
