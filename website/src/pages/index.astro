---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import { docs, REPO_URL } from '../lib/registry';
import savioPortrait from '../assets/images/st-dominic-savio-original.png';

const featured = docs.filter((d) => d.featured);

const pillars = [
  {
    n: 'I',
    name: 'Community',
    text: 'School Leads and Homeroom Hosts keep the culture alive in every room — every family known, every family invited, every time.',
  },
  {
    n: 'II',
    name: 'Formation',
    text: 'An eight-session parent series on social aggression, conflict, and childhood — because we cannot enforce a standard we cannot articulate.',
  },
  {
    n: 'III',
    name: 'Shared Language',
    text: 'A covenant and a glossary held in common, so a child, her parents, and the other family are finally using the same words.',
  },
  {
    n: 'IV',
    name: 'Conflict Navigation',
    text: 'A protocol for the hard conversation between parents — and trained facilitators for when it gets stuck.',
  },
  {
    n: 'V',
    name: 'Upstander Kids',
    text: 'Monthly club meetings where children rehearse courage — skits, stories, and scripts until standing up is muscle memory.',
  },
  {
    n: 'VI',
    name: 'Digital Oversight',
    text: 'Simple household norms every family can keep: messages open to review, no devices in bedrooms, nothing unfiltered, ever.',
  },
];
---

<Base>
  <!-- Hero -->
  <section class="mx-auto max-w-3xl px-5 pt-20 pb-10 text-center">
    <svg
      viewBox="0 0 24 24"
      class="mx-auto mb-6 size-8 text-gold"
      fill="none"
      stroke="currentColor"
      stroke-width="1.5"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <circle cx="12" cy="5" r="2"></circle>
      <path d="M12 7v13"></path>
      <path d="M5 12H2a10 10 0 0 0 20 0h-3"></path>
      <path d="M8 10l4-2 4 2"></path>
    </svg>
    <p class="eyebrow mb-6">A parent-led movement for Catholic grade schools</p>
    <h1 class="font-display text-5xl sm:text-6xl font-semibold leading-[1.08] text-ink-deep text-balance">
      Anchor your school<br class="hidden sm:block" /> in the Golden Rule.
    </h1>
  </section>

  <!-- Scripture -->
  <section class="border-y border-line bg-paper-deep">
    <div class="mx-auto max-w-2xl px-5 py-14 text-center font-serif italic text-ink-soft">
      <blockquote class="text-xl sm:text-2xl leading-relaxed">
        “So in everything, do to others what you would have them do to you, for this sums up the Law and the Prophets.”
      </blockquote>
      <p class="eyebrow mt-5 not-italic">Matthew 7:12</p>
    </div>
  </section>

  <!-- Why it exists -->
  <section class="mx-auto max-w-2xl px-5 py-20 text-center">
    <p class="eyebrow mb-10">Why it exists</p>
    <div class="space-y-6">
      <p class="font-display text-2xl sm:text-3xl font-semibold leading-snug text-ink-deep text-balance">
        Culture drifts without an anchor.
      </p>
      <p class="font-sans text-lg text-ink-soft">
        Teasing. Gossip. Exclusion. Small cruelties that compound.
      </p>
      <p class="font-display text-2xl sm:text-2xl font-semibold leading-snug text-ink-deep text-balance">
        It's not just the school's responsibility. It's all of ours.
      </p>
      <p class="font-display text-3xl sm:text-4xl font-semibold leading-snug text-gold text-balance">
        The Savio Standard is the anchor. Families. On purpose. Together.
      </p>
    </div>
  </section>

  <!-- How it works -->
  <section class="border-y border-line bg-paper-deep">
    <div class="mx-auto max-w-4xl px-5 py-16">
      <div class="ornament mb-10"><span class="eyebrow">How it works</span></div>
      <div class="grid gap-8 sm:grid-cols-3 text-center">
        <div>
          <h3 class="font-display text-xl font-semibold text-ink-deep mb-2">Expectations</h3>
          <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft">
            The Golden Rule becomes the standard, as Christ commands.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold text-ink-deep mb-2">Formation</h3>
          <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft">
            Parents trained together: shared language, shared protocols.
          </p>
        </div>
        <div>
          <h3 class="font-display text-xl font-semibold text-ink-deep mb-2">Covenant</h3>
          <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft">
            A commitment signed grade by grade. The anchor, made concrete.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="mx-auto max-w-3xl px-5 py-16 text-center">
    <div class="flex flex-wrap justify-center gap-4 font-sans">
      <a
        href="/the-case"
        class="rounded-md bg-ink-deep px-6 py-3 text-sm font-semibold tracking-wide text-paper uppercase hover:bg-ink transition-colors"
      >
        Read the Case
      </a>
      <a
        href="/library"
        class="rounded-md border border-gold px-6 py-3 text-sm font-semibold tracking-wide text-gold uppercase hover:bg-gold hover:text-paper transition-colors"
      >
        Explore the Library
      </a>
    </div>
  </section>

  <!-- Start by role -->
  <section class="mx-auto max-w-3xl px-5 pb-16">
    <div class="ornament mb-8"><span class="eyebrow">New here?</span></div>
    <div class="grid gap-5 sm:grid-cols-2">
      <a
        href="/for-parents"
        class="group rounded-lg border border-line bg-white/50 p-6 text-center transition-all hover:border-gold-soft hover:shadow-sm"
      >
        <h3 class="font-display text-2xl font-semibold text-ink-deep group-hover:text-gold transition-colors">
          For Parents
        </h3>
        <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft mt-2">
          Why culture drifts, and the playbook for restoring the Golden Rule as the standard.
        </p>
      </a>
      <a
        href="/for-schools"
        class="group rounded-lg border border-line bg-white/50 p-6 text-center transition-all hover:border-gold-soft hover:shadow-sm"
      >
        <h3 class="font-display text-2xl font-semibold text-ink-deep group-hover:text-gold transition-colors">
          For Schools &amp; Parishes
        </h3>
        <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft mt-2">
          What it is, why it helps, and how to bring it to your school.
        </p>
      </a>
    </div>
  </section>

  <!-- Patron -->
  <section class="border-y border-line bg-paper-deep">
    <div class="mx-auto max-w-4xl px-5 py-14">
      <div class="rounded-lg border border-line shadow-sm overflow-hidden bg-white flex flex-col sm:flex-row">
        <div class="h-full sm:h-auto sm:w-2/5 shrink-0">
          <Image
            src={savioPortrait}
            alt="St. Dominic Savio, patron of the Project"
            width={480}
            height={600}
            densities={[1, 1.5, 2]}
            loading="lazy"
            class="w-full h-full object-cover"
          />
        </div>
        <div class="flex-1 p-8 sm:p-10 flex flex-col justify-center text-center sm:text-left">
          <p class="eyebrow mb-4">St. Dominic Savio</p>
          <h2 class="font-display text-3xl font-semibold text-ink-deep mb-4">Our Patron</h2>
          <p class="font-sans text-sm leading-relaxed text-ink-soft">
            St. Dominic Savio was a schoolboy — fourteen when he died, canonized for the holiness of an ordinary school life. At his school he organized his classmates into a company of mutual care: he defended the smallest boys from bullying, broke up fights, and befriended the friendless. He is exactly what this movement asks our children to become, and behind the pupil stands the teacher — his mentor, St. John Bosco, who formed young people through reason, religion, and loving-kindness so thoroughly that discipline was rarely needed. Every gathering, covenant, and skit in this project is an attempt to make Savio’s way ordinary again.
          </p>
          <p class="mt-6 font-sans text-sm">
            <a href="/the-case#patronage-and-identity" class="text-gold font-semibold uppercase tracking-wide hover:text-ink-deep transition-colors">
              Read more in the Case →
            </a>
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pillars -->
  <section class="mx-auto max-w-5xl px-5 py-16">
    <div class="ornament mb-10"><span class="eyebrow">The six pillars</span></div>
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {
        pillars.map((p) => (
          <div class="rounded-lg border border-line bg-white/50 p-6">
            <div class="font-display text-gold text-xl font-semibold">{p.n}</div>
            <h3 class="font-display text-xl font-semibold text-ink-deep mt-1 mb-2">{p.name}</h3>
            <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft">{p.text}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Documents -->
  <section class="mx-auto max-w-5xl px-5 pb-16">
    <div class="ornament mb-10"><span class="eyebrow">Start reading</span></div>
    <div class="grid gap-6 sm:grid-cols-2">
      {
        featured.map((d) => (
          <a
            href={'/' + d.slug}
            class="group rounded-lg border border-line bg-white/50 p-6 transition-all hover:border-gold-soft hover:shadow-sm"
          >
            <p class="eyebrow mb-2">{d.section}</p>
            <h3 class="font-display text-2xl font-semibold text-ink-deep group-hover:text-gold transition-colors">
              {d.title}
            </h3>
            <p class="font-sans text-[0.95rem] leading-relaxed text-ink-soft mt-2">{d.description}</p>
          </a>
        ))
      }
    </div>
    <p class="mt-8 text-center font-sans text-sm text-ink-soft">
      Everything else — the glossary, the community roles, the facilitator guide, and the project’s own governance — is in the <a href="/library" class="text-gold underline underline-offset-2">library</a>.
    </p>
  </section>

  <!-- How it starts -->
  <section class="border-t border-line bg-paper-deep">
    <div class="mx-auto max-w-4xl px-5 py-16 text-center">
      <p class="eyebrow mb-4">How it starts</p>
      <h2 class="font-display text-3xl font-semibold text-ink-deep mb-10">No permission required</h2>
      <div class="grid gap-8 sm:grid-cols-3 font-sans text-[0.95rem] text-ink-soft">
        <div>
          <div class="font-display text-4xl text-gold font-semibold mb-2">1</div>
          <p><strong class="text-ink-deep">Sign the covenant.</strong> Privately — no one knows until your grade activates.</p>
        </div>
        <div>
          <div class="font-display text-4xl text-gold font-semibold mb-2">2</div>
          <p><strong class="text-ink-deep">Eight families activate a grade.</strong> All are introduced. No family stands alone.</p>
        </div>
        <div>
          <div class="font-display text-4xl text-gold font-semibold mb-2">3</div>
          <p><strong class="text-ink-deep">A community forms.</strong> Hosts, formation nights, a shared language — a culture, on purpose.</p>
        </div>
      </div>
      <div class="mt-10">
        <a
          href={REPO_URL}
          class="font-sans text-sm font-semibold uppercase tracking-wide text-gold hover:text-ink-deep transition-colors"
        >
          Built in the open on GitHub →
        </a>
      </div>
    </div>
  </section>
</Base>
