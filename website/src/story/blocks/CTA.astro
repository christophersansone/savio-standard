---
import type { CtaContent } from '../model';
import type { ResolvedPresentation } from '../types';
import { effectTargetClass } from '../effects';

interface Props {
  id: string;
  content: CtaContent;
  presentation: ResolvedPresentation;
}

const { id, content } = Astro.props;
const fadeClass = effectTargetClass('fade');
---

<aside class:list={['story-cta', 'story-inner', fadeClass]} id={id}>
  <h2 class="story-cta__title">{content.title}</h2>
  {content.text && <p class="story-cta__text">{content.text}</p>}
  <a class="story-cta__button" href={content.button.href}>{content.button.label}</a>
</aside>
