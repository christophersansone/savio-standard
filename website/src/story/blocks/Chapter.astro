---
import type { ChapterContent } from '../model';
import type { ResolvedPresentation } from '../types';
import { effectTargetClass } from '../effects';

interface Props {
  id: string;
  content: ChapterContent;
  presentation: ResolvedPresentation;
}

const { id, content } = Astro.props;
const revealClass = effectTargetClass('reveal');
---

<header class:list={['story-chapter', revealClass]} id={id}>
  <div class="story-ornament" aria-hidden="true"></div>
  <h2 class="story-chapter__title">{content.title}</h2>
  {content.subtitle && (
    <p class="story-chapter__subtitle">{content.subtitle}</p>
  )}
</header>
