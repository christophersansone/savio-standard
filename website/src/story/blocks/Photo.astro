---
import type { PhotoContent } from '../model';
import type { ResolvedPresentation } from '../types';
import { effectTargetClass } from '../effects';

interface Props {
  id: string;
  content: PhotoContent;
  presentation: ResolvedPresentation;
}

const { id, content, presentation } = Astro.props;
const layout = presentation.layout;
const alt = content.image.alt ?? content.caption ?? '';
const frameClass = [
  'story-photo__frame',
  effectTargetClass('fade'),
].join(' ');
const imgClass = [
  'story-photo__img',
  effectTargetClass('parallax'),
  effectTargetClass('zoom'),
].join(' ');
const captionClass = effectTargetClass('fade');
---

<figure
  class:list={['story-photo', `story-photo--${layout}`]}
  id={id}
>
  <div class={frameClass}>
    <img
      class={imgClass}
      src={content.image.src}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
  </div>
  {content.caption && (
    <figcaption class:list={['story-photo__caption', captionClass]}>
      {content.caption}
    </figcaption>
  )}
</figure>
