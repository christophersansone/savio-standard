---
import type { QuoteContent } from '../model';
import type { ResolvedPresentation } from '../types';
import { effectTargetClass } from '../effects';

interface Props {
  id: string;
  content: QuoteContent;
  presentation: ResolvedPresentation;
}

const { id, content } = Astro.props;
const fadeClass = effectTargetClass('fade');
const bg = content.background;
---

<figure
  class:list={['story-quote', bg && 'story-quote--has-bg']}
  id={id}
>
  {bg && (
    <div
      class="story-quote__media"
      style={`background-image: url(${bg.src})`}
      aria-hidden="true"
    ></div>
  )}
  <div class:list={['story-quote__content', fadeClass]}>
    <blockquote class="story-quote__text">{content.quote}</blockquote>
    {content.attribution && (
      <figcaption class="story-quote__attribution">{content.attribution}</figcaption>
    )}
  </div>
</figure>
