---
import type { StatisticContent } from '../model';
import type { ResolvedPresentation } from '../types';
import { effectTargetClass } from '../effects';

interface Props {
  id: string;
  content: StatisticContent;
  presentation: ResolvedPresentation;
}

const { id, content } = Astro.props;
const display = `${content.prefix}${content.number}${content.suffix}`;
const revealClass = effectTargetClass('reveal');
---

<div class:list={['story-statistic', 'story-inner', revealClass]} id={id}>
  <p
    class="story-statistic__number"
    data-count-to={content.number}
    data-count-prefix={content.prefix || undefined}
    data-count-suffix={content.suffix || undefined}
  >
    {display}
  </p>
  <p class="story-statistic__label">{content.label}</p>
  {content.description && (
    <p class="story-statistic__description">{content.description}</p>
  )}
</div>
